---
// Game compatibility from src/data/compatibility.json; later fed from the community compatibility reports.
import games from '../data/compatibility.json';

const labels: Record<string, string> = {
	plays: 'Plays',
	issues: 'Issues',
	fails: 'Does not work',
	untested: 'Untested',
};
const sorted = [...games].sort((a, b) => a.game.localeCompare(b.game));
---

<table>
	<thead>
		<tr>
			<th>Game</th>
			<th>State</th>
			<th>Tested</th>
			<th>Notes</th>
		</tr>
	</thead>
	<tbody>
		{
			sorted.map((entry) => (
				<tr>
					<td>{entry.game}</td>
					<td>
						<span class="compat-status" data-status={entry.status}>
							{labels[entry.status] ?? entry.status}
						</span>
					</td>
					<td>{entry.tested}</td>
					<td>{entry.notes}</td>
				</tr>
			))
		}
	</tbody>
</table>
