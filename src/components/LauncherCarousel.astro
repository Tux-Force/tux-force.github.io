---
const slides = [
  { title: 'Library', file: 'library', alt: 'xTux Launcher library with installed games, Play buttons and compatibility indicators', caption: 'Installed games, install sources and compatibility at a glance.' },
  { title: 'Store', file: 'store', alt: 'xTux Launcher Store with game covers and catalog filters', caption: 'Explore the catalog with Game Pass, Owned and Installed filters.' },
  { title: 'Game details', file: 'detail', alt: 'xTux Launcher game detail view with artwork, Play button and per-game settings', caption: 'Game artwork, the Play button and individual Wine settings.' },
];
---

<launcher-carousel class="not-content" role="region" aria-roledescription="carousel" aria-label="xTux Launcher screenshots" tabindex="0">
  <div class="slides">
    {slides.map((slide, index) => (
      <figure data-slide hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${slides.length}: ${slide.title}`}>
        <a href={`/screenshots/launcher-${slide.file}.png`} aria-label={`Enlarge ${slide.title} screenshot`} aria-haspopup="dialog">
          <img src={`/screenshots/launcher-${slide.file}.png`} alt={slide.alt} width="1240" height="800" loading="lazy" draggable="false" />
        </a>
        <figcaption><strong>{slide.title}</strong><span>{slide.caption}</span></figcaption>
      </figure>
    ))}
  </div>
  <div class="controls" hidden>
    <button type="button" data-step="-1" aria-label="Previous screenshot"><span aria-hidden="true">←</span></button>
    <div class="dots" role="group" aria-label="Choose screenshot">
      {slides.map((slide, index) => (
        <button type="button" data-index={index} aria-label={`Show ${slide.title}`} aria-pressed={index === 0}><span aria-hidden="true"></span></button>
      ))}
    </div>
    <button type="button" data-step="1" aria-label="Next screenshot"><span aria-hidden="true">→</span></button>
  </div>
  <p class="position" aria-live="polite" aria-atomic="true">1 / 3 — Library</p>
  <dialog class="lightbox" aria-label="Enlarged xTux Launcher screenshots">
    <div class="lightbox-bar">
      <p data-lightbox-position aria-live="polite" aria-atomic="true"></p>
      <button type="button" data-close aria-label="Close enlarged screenshot" autofocus>✕</button>
    </div>
    <img class="lightbox-image" data-lightbox-image width="1240" height="800" alt="" draggable="false" />
    <div class="lightbox-controls">
      <button type="button" data-step="-1" aria-label="Previous enlarged screenshot">←</button>
      <p>← → to browse · Esc to close</p>
      <button type="button" data-step="1" aria-label="Next enlarged screenshot">→</button>
    </div>
  </dialog>
</launcher-carousel>

<script>
  class LauncherCarousel extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const slides = [...this.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = [...this.querySelectorAll<HTMLButtonElement>('[data-index]')];
      const position = this.querySelector<HTMLElement>('.position')!;
      const dialog = this.querySelector<HTMLDialogElement>('dialog')!;
      const enlarged = this.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
      const enlargedPosition = this.querySelector<HTMLElement>('[data-lightbox-position]')!;
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let current = 0;
      let oldOverflow = '';
      let closing = false;
      let suppressedUntil = 0;
      const animate = (element: HTMLElement, frames: Keyframe[], duration = 260) => {
        element.getAnimations().forEach(animation => animation.cancel());
        if (reducedMotion.matches) return;
        return element.animate(frames, { duration, easing: 'cubic-bezier(.22,1,.36,1)' });
      };
      const show = (index: number) => {
        const direction = index < current ? -1 : 1;
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => { slide.hidden = i !== current; });
        dots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === current)));
        const title = slides[current].querySelector('strong')!.textContent;
        position.textContent = enlargedPosition.textContent = `${current + 1} / ${slides.length} — ${title}`;
        const image = slides[current].querySelector('img')!;
        enlarged.src = image.src;
        enlarged.alt = image.alt;
        animate(dialog.open ? enlarged : slides[current], [
          { opacity: 0, transform: `translateX(${direction * 18}px)` },
          { opacity: 1, transform: 'translateX(0)' },
        ]);
      };
      const close = async () => {
        if (!dialog.open || closing) return;
        closing = true;
        const animation = animate(dialog, [
          { opacity: 1, transform: 'translateY(0) scale(1)' },
          { opacity: 0, transform: 'translateY(10px) scale(.98)' },
        ], 160);
        await animation?.finished.catch(() => {});
        dialog.close();
        closing = false;
      };
      dialog.addEventListener('close', () => {
        document.documentElement.style.overflow = oldOverflow;
        slides[current].querySelector('a')?.focus({ preventScroll: true });
      });
      dialog.addEventListener('cancel', event => { event.preventDefault(); void close(); });
      this.querySelector('[data-close]')!.addEventListener('click', () => { void close(); });
      // Only a press and release on the backdrop dismisses the image.
      let backdropPress = false;
      dialog.addEventListener('pointerdown', event => { backdropPress = event.target === dialog; });
      dialog.addEventListener('click', event => {
        if (event.target === dialog && backdropPress) void close();
        backdropPress = false;
      });
      slides.forEach(slide => {
        slide.querySelector('a')!.addEventListener('click', event => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          if (Date.now() < suppressedUntil || dialog.open) return;
          show(slides.indexOf(slide));
          oldOverflow = document.documentElement.style.overflow;
          document.documentElement.style.overflow = 'hidden';
          dialog.showModal();
          animate(dialog, [
            { opacity: 0, transform: 'translateY(16px) scale(.96)' },
            { opacity: 1, transform: 'translateY(0) scale(1)' },
          ], 300);
        });
      });
      this.querySelector<HTMLElement>('.controls')!.hidden = false;
      this.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button => {
        button.addEventListener('click', () => show(current + Number(button.dataset.step)));
      });
      dots.forEach(button => button.addEventListener('click', () => show(Number(button.dataset.index))));
      this.addEventListener('keydown', event => {
        const targets: Record<string, number> = { ArrowLeft: current - 1, ArrowRight: current + 1, Home: 0, End: slides.length - 1 };
        if (event.key in targets) { event.preventDefault(); show(targets[event.key]); }
      });
      for (const surface of [this.querySelector<HTMLElement>('.slides')!, enlarged]) {
        let start: { x: number; y: number } | undefined;
        surface.addEventListener('pointerdown', event => {
          if (event.isPrimary && event.button === 0) start = { x: event.clientX, y: event.clientY };
        });
        surface.addEventListener('pointercancel', () => { start = undefined; });
        surface.addEventListener('pointerup', event => {
          if (!start) return;
          const dx = event.clientX - start.x;
          const dy = event.clientY - start.y;
          start = undefined;
          if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
            suppressedUntil = Date.now() + 350;
            show(current + (dx < 0 ? 1 : -1));
          }
        });
      }
    }
  }
  if (!customElements.get('launcher-carousel')) customElements.define('launcher-carousel', LauncherCarousel);
</script>

<style>
  launcher-carousel { display: block; margin-block: 1.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: 1rem; overflow: hidden; background: var(--sl-color-gray-6); }
  [hidden] { display: none !important; }
  figure { margin: 0; }
  .slides { touch-action: pan-y; }
  figure a { display: block; cursor: zoom-in; overflow: hidden; }
  figure a img { transition: transform 280ms ease; }
  figure a:hover img { transform: scale(1.015); }
  img { display: block; width: 100%; height: auto; margin: 0; }
  figcaption { display: flex; flex-direction: column; gap: .25rem; padding: 1rem 1.25rem .5rem; }
  figcaption strong { color: var(--sl-color-white); font-size: 1.125rem; }
  figcaption span { color: var(--sl-color-gray-2); font-size: .9rem; }
  .controls { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: .5rem 1rem 0; }
  button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid var(--sl-color-gray-4); border-radius: 50%; background: transparent; color: var(--sl-color-white); cursor: pointer; font: inherit; font-size: 1.25rem; transition: background 180ms ease, border-color 180ms ease, transform 180ms ease; }
  button:hover { border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
  button:focus-visible, launcher-carousel:focus-visible { outline: 3px solid var(--sl-color-accent); outline-offset: -3px; }
  .dots { display: flex; }
  .dots button { border: 0; border-radius: .5rem; }
  .dots span { transition: width 220ms ease, background 220ms ease; width: 9px; height: 9px; background: var(--sl-color-gray-3); border-radius: 50%; }
  .dots [aria-pressed='true'] span { width: 22px; border-radius: 6px; background: var(--sl-color-accent); }
  .position { margin: 0; padding: .25rem 1rem 1rem; text-align: center; color: var(--sl-color-gray-2); font-size: .8rem; }
  .lightbox { position: fixed; inset: 0; margin: auto; width: min(94vw, 1500px); max-width: none; max-height: 96dvh; padding: .75rem; border: 1px solid #a3e63555; border-radius: 1rem; background: #06140f; color: #f4f7fb; box-shadow: 0 24px 100px #0008; }
  .lightbox::backdrop { background: #020907de; backdrop-filter: blur(10px); animation: backdrop-in 220ms ease both; }
  .lightbox-bar, .lightbox-controls { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .lightbox-bar { padding: 0 0 .75rem .5rem; }
  .lightbox p { margin: 0; font-size: .9rem; }
  .lightbox-image { width: 100%; height: auto; max-height: calc(96dvh - 150px); object-fit: contain; border-radius: .5rem; touch-action: pan-y; }
  .lightbox-controls { padding-top: .75rem; }
  .lightbox-controls p { color: #8fb5a3; font-size: .8rem; text-align: center; }
  .lightbox button { flex-shrink: 0; border-color: #4f6f61; color: #f4f7fb; }
  .lightbox button:hover { background: #0f3b2e; border-color: #a3e635; }
  @keyframes backdrop-in { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    figure a img, button, .dots span { transition: none; }
    figure a:hover img { transform: none; }
    .lightbox::backdrop { animation: none; }
  }
</style>
